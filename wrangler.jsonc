{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myportfolio",
  "compatibility_date": "2026-07-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    { "pattern": "jecintatechworks.com", "custom_domain": true },
    { "pattern": "www.jecintatechworks.com", "custom_domain": true }
  ]
}